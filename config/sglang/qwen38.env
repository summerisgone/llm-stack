# SGLang, "baseline" profile: the same NVFP4 checkpoint vLLM serves, run by
# deploy/sglang-qwen38/run on the WSL2 host. Not deployed by Kubernetes --
# this env file is read directly by that script. Mirrors the "baseline"
# variant of the host's own /home/llmstack/sglang-qwen38/scripts/
# manage_sglang_qwen38.sh, which has been running this checkpoint in
# production use; other tuned variants (eagle, dspark, agents_*) live only
# on that host script until they need to be reproducible from this repo too.
#
# Mutually exclusive with vLLM (k8s/overlays/remote-wsl-vllm-nvfp4/vllm.yaml):
# this host has one RTX 5090. Stop vLLM before starting this, and flip
# inference.sglang.enabled in helm/airgap-stack/values.yaml only once it is
# actually running -- see docs/adr/0006-pluggable-inference-backends.md.
MODEL_PATH=/home/llmstack/models/RadixArk-Qwen3.8-27B-NVFP4
SERVED_MODEL_NAME=qwen-3.8-27b
PORT=30000
API_KEY_FILE=/home/llmstack/.config/sglang/api_key

# `sglang serve` flags, baseline variant: fits the 27B checkpoint in the
# 32 GiB VRAM budget with FP8 KV cache, no speculative decoding.
SGLANG_ARGS=--attention-backend flashinfer --mamba-ssm-dtype bfloat16 --mamba-radix-cache-strategy extra_buffer_lazy --chunked-prefill-size 2048 --reasoning-parser qwen3 --tool-call-parser qwen3_coder --mm-feature-transport cpu --enable-cache-report --enable-metrics --context-length 16384 --max-running-requests 1 --cuda-graph-max-bs-decode 1 --max-mamba-cache-size 4 --mem-fraction-static 0.90 --kv-cache-dtype fp8_e4m3 --mamba-full-memory-ratio 0.5845
