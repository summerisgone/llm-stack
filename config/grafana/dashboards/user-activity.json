            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(patsvc_requests_total{outcome=~\"rejected|error\", user=~\"$user\"}[$__range])) / sum(increase(patsvc_requests_total{user=~\"$user\"}[$__range]))",
