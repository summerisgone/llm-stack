  "description": "TASK-qos-fair-share.md Stage 4: per-user token consumption, TTFT and TPOT, plus GPU cost and request outcomes. Observation only, alongside the Fair Share (QoS) dashboard which covers session stitching and band assignment. TTFT/TPOT/token panels read llm-d EPP's own per-fairness_id histograms (fairness_id = the same Keycloak sub pat-service uses as 'user' everywhere else) -- pat-service does not duplicate that instrumentation. Cost panels read pat-service's own patsvc_cost_units_total, the alpha/beta-weighted GPU-cost axis EPP has no notion of; today it is populated from non-streaming responses only (docs/adr/0008-per-user-fair-share.md \"Stage 4\").",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Chat-completion calls dispatched through pat-service in the selected range, across all users.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(patsvc_requests_total{outcome=\"dispatched\", user=~\"$user\"}[$__range]))",
          "refId": "A"
        }
      ],
      "title": "Dispatched requests",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Share of chat-completion calls that came back rejected (429) or error (5xx/proxy failure) instead of dispatched, in the selected range.",
