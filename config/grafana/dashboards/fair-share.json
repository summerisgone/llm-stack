  "description": "TASK-qos-fair-share.md Stage 3 step 1: chain-hash session matching, observation mode only. No slot/queue/cost panels yet -- those need Stage 3 steps 2-4 (admission control) and are not implemented.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The trust signal for every other session-scoped number this design produces (docs/adr/0008-per-user-fair-share.md, \"Known limitations\"). Should climb close to 100% on real coding-agent traffic; a ratio that stays low means the chain heuristic itself needs revisiting.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(patsvc_session_match_total{result=\"matched\"}[$__range])) / sum(increase(patsvc_session_match_total{result=~\"matched|new\"}[$__range]))",
          "refId": "A"
        }
      ],
      "title": "Session match ratio (trust signal)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Distinct sessions active per user within the session TTL window. Should track the number of agents a user actually has running, not their request rate -- if this grows linearly with traffic instead of staying flat, chain matching is broken (TASK-qos-fair-share.md Stage 3 step 1's stated highest-risk failure).",
