{
  "providers": {
    "pat": {
      "baseUrl": "http://pat-service.airgap-ai-stack.svc.cluster.local:8080/v1",
      "api": "openai-completions",
      "apiKey": "${AGENT_INFERENCE_KEY}",
      "models": [
        {
          "id": "default",
          "name": "Default model (current engine)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 131072,
          "maxTokens": 32768,
          "compat": {"thinkingFormat": "qwen-chat-template"}
        }
      ]
    }
  }
}
