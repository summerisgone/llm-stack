# Host-run Strata (deploy/strata/run). The model directory is the one in
# models/manifest.yaml (strata-qwen3.8-flash-next-iq3_s), laid out as Strata's
# setup.py prepares it; the image is versions.lock.env STRATA_IMAGE.
STRATA_MODEL_DIR=/home/dental/models/strata-qwen3.8-flash-next-iq3_s
STRATA_IMAGE=ghcr.io/summerisgone/strata:strata-db4f91a1171d
STRATA_CONTAINER_NAME=strata
# inference.externalApi.port in helm/airgap-stack/values.yaml.
PORT=8095
