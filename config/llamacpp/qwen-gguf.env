# Fill only after a GGUF model has been verified and checksummed (see
# models/manifest.yaml and models/checksums.txt), the same rule
# config/sglang/qwen38.env follows. Nothing reads this file until then.
MODEL_GGUF=/home/llmstack/models/CHANGE-ME.gguf
SERVED_MODEL_NAME=llamacpp-local
PORT=8090
# 0 keeps the whole model on CPU. This host has one GPU already claimed by
# vLLM (or SGLang, see config/sglang/model-profiles); do not set this above 0
# while either of those is running.
N_GPU_LAYERS=0
CTX_SIZE=8192
