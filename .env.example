# Local development credentials. Copy to .env and replace all values before
# exposing the stack outside the local machine. .env is intentionally ignored.
# On a clean Langfuse bootstrap these keys initialize the first project. If a
# Langfuse volume already exists, replace them with that project's real API
# keys from Settings -> API Keys before starting the stack.
LANGFUSE_PUBLIC_KEY=lf_pk_ai_stack_local_demo_only
LANGFUSE_SECRET_KEY=lf_sk_ai_stack_local_demo_only
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_INIT_ORG_ID=ai-stack
LANGFUSE_INIT_ORG_NAME=AI Stack
LANGFUSE_INIT_PROJECT_ID=local-ai-stack
LANGFUSE_INIT_PROJECT_NAME=Local AI Stack
LANGFUSE_INIT_USER_EMAIL=admin@langfuse.localhost
LANGFUSE_INIT_USER_NAME=AI Stack Admin
LANGFUSE_INIT_USER_PASSWORD=langfuse-admin-demo-only
# HMAC keys are never persisted in the PAT database. Rotate PAT_HASH_KEY only
# with an explicit token migration/revocation plan, because it invalidates all
# stored hashes. These demo values must be replaced outside local development.
PAT_HASH_KEY=replace-this-with-a-unique-32-byte-minimum-pat-hash-key
PAT_COOKIE_KEY=replace-this-with-a-unique-32-byte-minimum-cookie-signing-key
PAT_GATEWAY_CLIENT_SECRET=pat-gateway-demo-only
# Keep this stable across Open WebUI restarts. Changing it invalidates stored
# OAuth sessions, so generate a unique value before deploying outside local dev.
WEBUI_SECRET_KEY=replace-this-with-a-unique-openwebui-session-encryption-key
# PAT used by Open WebUI's Automations connection (scheduled runs have no
# browser session): issue one for a dedicated user with scripts/kc-pat-issue.
# Required: the Open WebUI pod reads this key from airgap-runtime.
OPENWEBUI_AUTOMATIONS_PAT=replace-with-a-pat-for-open-webui-automations
# Optional upstream bearer tokens for the inference backends in
# helm/airgap-stack/values.yaml `inference`. Leave empty unless that backend
# actually requires one. vLLM and SGLang need none: they are reachable only
# from EPP and Prometheus (NetworkPolicy, ADR 0019).
# With Strata on the GPU host (deploy/strata/README.md) this is also the key
# its container gets as STRATA_API_KEY.
EXTERNAL_API_KEY=
# ninfer-serve enforces an API key like SGLang; becomes the ninfer-api-key
# Secret. Needed only when NINFER_REPLICAS is above 0.
NINFER_API_KEY=
# serve/server.py enforces it; becomes the strata-api-key Secret. Needed
# only when STRATA_REPLICAS is above 0.
STRATA_API_KEY=
# Engine replicas (ADR 0019). vLLM and SGLang pods serve qwen-3.8-27b
# through EPP; ninfer serves its own name, qwen-3.8-27b-ninfer, and Strata
# qwen-3.8-flash-next. `make engines-up` applies them. One GPU: keep the total at 1.
VLLM_REPLICAS=1
SGLANG_REPLICAS=0
NINFER_REPLICAS=0
STRATA_REPLICAS=0
# 1 while Strata runs on the GPU host instead (deploy/strata/run, served
# through inference.externalApi); every *_REPLICAS above stays 0 then.
STRATA_ON_HOST=0
# Engine behind the model name `default` (pool, ninfer, strata, externalApi,
# llamacpp). Unset: derived from the replicas above; make helm-up applies it.
# DEFAULT_ENGINE=
# Web search through OpenSERP (docs/adr/0017-web-search-mcp-openserp-kagent.md).
# true installs helm/web-search in `make stack-up`, opens pat-service
# /mcp/web-search/, adds the MCP tool to the agents and Open WebUI. Queries
# leave the company to public search engines. Keep false on air-gapped installs.
WEB_SEARCH_ENABLED=false
# Repowise codebase intelligence (docs/adr/0018-repowise-codebase-intelligence.md).
# true opens pat-service /mcp/repowise/, adds the MCP tool to the agents and
# Open WebUI, and lets `make repowise-up` install helm/repowise. Requires
# embeddings-inference in accelerator: gpu mode. Repositories are fetched from
# the internet: keep false on air-gapped installs.
REPOWISE_ENABLED=false
# The UI's own public origin (section 3): a second site-proxy rule for this
# host forwarding to the same edge listener as the main origin. Keycloak's
# issuer is taken from STACK_BASE_URL (the main origin).
REPOWISE_PUBLIC_ORIGIN=https://repowise.example.com
# DeepSeek Harness agent (docs/adr/0020-dsh-runtime-and-per-user-web-ui.md).
# The per-user dsh web UI's public origin: a site-proxy rule for this host
# forwarding to the same edge listener as the main origin (like
# REPOWISE_PUBLIC_ORIGIN). Empty = the dsh agent is offered in Open WebUI
# only, without the web UI.
DSH_PUBLIC_ORIGIN=https://dsh.example.com
# Confidential Keycloak client `dsh-web` (make provision-dsh-oidc).
DSH_OIDC_CLIENT_SECRET=dsh-web-oauth-demo-only
# Runtimes served through the Open WebUI agent Pipe
# (docs/adr/0021-openwebui-pipe-and-acp-agent-integration.md): tool progress
# and permission prompts. Comma-separated subset of dsh,opencode,pi,hermes;
# a listed runtime runs over ACP (hermes needs the agent-hermes image as
# HERMES_IMAGE). Empty = the Pipe offers no models and the agents run
# natively behind the existing connection. Applied by `make agents-up`
# (broker) and `make openwebui-agent-pipe`.
AGENT_PIPE_RUNTIMES=
# Main public origin; also switches scripts/lib-endpoints to path mode, so it
# stays commented on the local-mac profile. Required on the remote profile by
# `make helm-up`, `monitoring-up`, `agents-up` and `repowise-up`.
# STACK_BASE_URL=https://example.com
# Grafana's operator URL (OIDC redirect target), remote profile. The Makefile
# default is a placeholder host.
# GRAFANA_BASE_URL=http://grafana.example.local:32030
# Shared API key; injected by the gateway, never seen by browsers.
REPOWISE_API_KEY=replace-with-a-random-repowise-api-key
# Confidential Keycloak client `repowise` (make provision-repowise-oidc).
REPOWISE_OIDC_CLIENT_SECRET=repowise-oauth-demo-only
# PAT of the Keycloak service user svc-repowise (scripts/kc-user-add, then
# scripts/kc-pat-issue): repowise's LLM and embeddings identity.
REPOWISE_PAT=
