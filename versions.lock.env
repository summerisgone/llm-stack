# Image references are deliberately pinned. Update this file and the matching
# Kubernetes manifest together, then record the resulting digest for an air-gap bundle.
ENVOY_VERSION=v1.36.0
KEYCLOAK_VERSION=26.1.4
OPENWEBUI_VERSION=v0.11.4
POSTGRES_VERSION=17.5-alpine
CLICKHOUSE_VERSION=25.12
VALKEY_VERSION=8.0.2-alpine
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
LANGFUSE_VERSION=4.41.0
OTEL_COLLECTOR_VERSION=0.114.0
PROMETHEUS_VERSION=v3.3.0
# Host/GPU collectors scraped by the airgap Prometheus for the system-state
# dashboard. Keep the image tags in k8s/overlays/remote-wsl-vllm-nvfp4/*-exporter.yaml
# in step with these versions.
NODE_EXPORTER_VERSION=v1.8.2
# GPU state is exported by the stack's own gpu-exporter (nvidia-smi based) —
# see k8s/overlays/remote-wsl-vllm-nvfp4/gpu-exporter.yaml. DCGM-exporter does
# not support the WSL2 paravirtual GPU, so it is not used here.
GRAFANA_VERSION=12.0.0
VLLM_VERSION=0.27.1
VLLM_CPU_IMAGE_DIGEST=sha256:5966fcc14fe241ee7f2dc3d3fd5610ed12968eb9c0d096e1089802b79681efc4
VLLM_CPU_IMAGE=vllm/vllm-openai-cpu@sha256:5966fcc14fe241ee7f2dc3d3fd5610ed12968eb9c0d096e1089802b79681efc4
GAIE_VERSION=v1.5.0
LLMD_ROUTER_CHART_VERSION=v0
LLMD_ROUTER_GATEWAY_CHART_DIGEST=sha256:0ea63f2bd043c0b76118684956b176c77ae309a6f5f49635317ecf0046a15f8f
LLMD_ROUTER_STANDALONE_CHART_DIGEST=sha256:d42c95227258d05418c82bf9b7f55627d1309c2aececf84dea8d32167357e6fb
# The upstream chart v0 currently references EPP's mutable `main` tag. Its
# manifest digest at integration time is recorded for air-gap mirroring.
LLMD_EPP_IMAGE=ghcr.io/llm-d/llm-d-router-endpoint-picker:main
LLMD_EPP_IMAGE_MANIFEST_DIGEST=sha256:16a19db9203b6bd9945453e2b1a263bd19c6dff4de93fa99dc0e32f253d3d548

# Optional inference backends (docs/adr/0006-pluggable-inference-backends.md,
# docs/adr/0007-inference-engines-as-helm-releases.md).
# SGLANG_IMAGE is also the `image` value of helm/sglang-inference, which is
# what runs in the cluster; keep the two in step. deploy/sglang-qwen38/run
# and deploy/llamacpp/run start the same images as host Docker containers and
# take SGLANG_IMAGE / LLAMACPP_IMAGE as env overrides. LLAMACPP_IMAGE is not
# referenced by any manifest.
SGLANG_IMAGE=lmsysorg/sglang:v0.5.19@sha256:d6e7288627be8b02be88e4bba38e73f6d50e2826869f753c13a4c4385ab3eda9
# No published digest to pin against yet: this is a rolling upstream tag.
# Record the digest of whatever gets pulled (see deploy/llamacpp/README.md)
# for an air-gap bundle.
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# First-party image, built and published by
# .github/workflows/pat-service-image.yml on every push to pat-service/**.
# No digest pinned yet -- see docs/airgap. Keep this in step with the `image`
# value in k8s/base/applications.yaml.
PAT_SERVICE_IMAGE=ghcr.io/summerisgone/pat-service:latest

# ninfer pilot (docs/adr/0015-third-party-engine-metrics-contract.md,
# ~/agent/ninfer-pilot-task.md). Not published anywhere upstream -- no image,
# no tags, no releases on github.com/Neroued/ninfer (checked directly against
# the repo API). Built and pushed by .github/workflows/ninfer-image.yml from
# a pinned upstream commit, the same way this repo pins everything else it
# does not control (verified: run 35439158747, 2026-09-19, concluded
# success -- ghcr.io/summerisgone/ninfer:latest and :ninfer-9e163eee4b8a both
# published). Re-pin NINFER_UPSTREAM_REF deliberately, not on every upstream
# push -- there is no changelog upstream to review a bump against; bumping
# it is exactly the "change related to the image" that re-triggers the
# workflow's push trigger below.
NINFER_UPSTREAM_REF=9e163eee4b8acec21ab0ac765107b6a3f287b217
# Also helm/ninfer-inference/values.yaml's `image`; keep both pinned to the
# same immutable ninfer-<short-ref> tag (not :latest -- see that file's
# comment for why floating tags are actively wrong here, not just imprecise).
NINFER_IMAGE=ghcr.io/summerisgone/ninfer:ninfer-9e163eee4b8a

# bge-m3 embeddings (docs/adr/0013-embeddings-api-bge-m3.md). EMBEDDINGS_CPU_IMAGE
# is also the `image.cpu` value of helm/embeddings-inference; keep the two in
# step, same convention as SGLANG_IMAGE above. EMBEDDINGS_GPU_IMAGE has no
# value yet: ADR-0013 V3 picks TEI's CUDA image (if it passes on SM 12.0
# under the legacy hook) or falls back to the pinned vLLM pooling runner
# image already used by helm/vllm-inference; record the choice here when V3
# closes.
EMBEDDINGS_CPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.3@sha256:ad950d30878eceb72aaf32024d26fa2b1d04a75304fa0b4776b49aa1941fea07
EMBEDDINGS_GPU_IMAGE=

# --- Helm chart versions ----------------------------------------------------
# The Makefile `include`s this file, so these are the single source of truth
# for every `helm upgrade --install --version` in the deploy path. Update here,
# not in the Makefile, and record the resulting digests for an air-gap bundle.
ENVOY_GATEWAY_CHART_VERSION=v1.8.1
ENVOY_GATEWAY_ADDONS_CHART_VERSION=v1.8.1
AI_GATEWAY_CHART_VERSION=v1.1.0
AI_GATEWAY_CRDS_CHART_VERSION=v1.1.0
CNPG_CHART_VERSION=0.29.0
CLICKHOUSE_OPERATOR_CHART_VERSION=0.27.3
REDIS_OPERATOR_CHART_VERSION=0.26.1
MINIO_OPERATOR_CHART_VERSION=7.1.1
# gitgrave v7.1.2 includes upstream #2463 (exit cleanly on leadership loss).
# The published upstream Helm chart remains 7.1.1; override its operator image.
MINIO_OPERATOR_IMAGE_REPOSITORY=ghcr.io/gitgrave/minio-operator
MINIO_OPERATOR_IMAGE_TAG=v7.1.2
MINIO_OPERATOR_IMAGE_DIGEST=2da91baa81d382c6121e05e338acd4faaf1efd711b815f9a362ada8f3b6b136f
