#!/usr/bin/env sh
set -eu

env_file=${LLAMACPP_ENV_FILE:-"$(CDPATH= cd -- "$(dirname -- "$0")/../../config/llamacpp" && pwd)/qwen-gguf.env"}
if [ -f "$env_file" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
fi

container_name=${LLAMACPP_CONTAINER_NAME:-llamacpp}
served_model_name=${SERVED_MODEL_NAME:-llamacpp-local}
port=${PORT:-8090}
timeout=${LLAMACPP_STARTUP_TIMEOUT_SECONDS:-300}
endpoint="http://127.0.0.1:$port"

elapsed=0
until curl --fail --silent --show-error "$endpoint/v1/models" >/dev/null; do
  if ! docker ps --format '{{.Names}}' | grep -qx "$container_name"; then
    docker logs "$container_name" >&2 || true
    printf '%s\n' 'llama.cpp exited before becoming healthy.' >&2
    exit 1
  fi
  if [ "$elapsed" -ge "$timeout" ]; then
    docker logs --tail 200 "$container_name" >&2 || true
    printf '%s\n' "Timed out after ${timeout}s waiting for llama.cpp." >&2
    exit 1
  fi
  sleep 5
  elapsed=$((elapsed + 5))
done

response=$(curl --fail --silent --show-error \
  --header 'Content-Type: application/json' \
  --data "{\"model\":\"$served_model_name\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: LLAMACPP_OK\"}],\"temperature\":0,\"max_tokens\":32}" \
  "$endpoint/v1/chat/completions")

printf '%s\n' "$response" | grep -q 'LLAMACPP_OK' || {
  printf '%s\n' "$response" >&2
  printf '%s\n' 'The server answered, but the expected coherent token was absent.' >&2
  exit 1
}

printf '%s\n' 'llama.cpp smoke test passed.'
