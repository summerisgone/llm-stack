#!/usr/bin/env python3
"""Reset a Keycloak user's password through the admin API. Prints the new
password once unless one was supplied with --password; a generated password
is not recoverable afterwards.
"""
import argparse
import os
import secrets
import string
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lib_keycloak_admin import KeycloakAdmin  # noqa: E402


def generate_password():
    # Realm password policy (provision-realm-security): 12+ chars, upper,
    # lower, digit, special.
    alphabet = string.ascii_letters + string.digits
    while True:
        pw = "".join(secrets.choice(alphabet) for _ in range(16)) + secrets.choice("!@#$%^&*-_")
        if any(c.islower() for c in pw) and any(c.isupper() for c in pw) and any(c.isdigit() for c in pw):
            return pw


def main():
    parser = argparse.ArgumentParser(description="Reset a Keycloak user's password.")
    parser.add_argument("username")
    parser.add_argument("--password", help="new password; if omitted, a policy-conforming one is generated")
    args = parser.parse_args()

    password = args.password or generate_password()

    with KeycloakAdmin() as kc:
        users = kc.request("GET", f"/users?username={args.username}&exact=true")
        if not users:
            sys.exit(f"no such user: {args.username}")
        user_id = users[0]["id"]

        kc.request(
            "PUT",
            f"/users/{user_id}/reset-password",
            {"type": "password", "value": password, "temporary": False},
        )

    print(f"user:     {args.username}")
    print(f"user_id:  {user_id}")
    print(f"password: {password}")


if __name__ == "__main__":
    main()