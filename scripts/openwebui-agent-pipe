#!/usr/bin/env python3
"""Install or update the Open WebUI agent Pipe (config/openwebui/agent_pipe.py,
docs/adr/0021) through Open WebUI's admin API: create or update function
`agent_pipe` from the repository source, activate it, and set its valves so
it offers one model per runtime in AGENT_PIPE_RUNTIMES. An empty list
leaves the Pipe installed with no models (rollback to the agent connection).

Needs OPENWEBUI_API_KEY (an admin's key) from the environment or .env, and
STACK_BASE_URL like the smoke tests (scripts/lib_endpoints.py). Run from
the repository root: `make openwebui-agent-pipe`.
"""
import json
import os
import sys
import urllib.error

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lib_endpoints import Endpoints  # noqa: E402

FUNCTION_ID = "agent_pipe"
SOURCE = "config/openwebui/agent_pipe.py"
# Broker model ids and titles (agent-broker main.go).
MODELS = {
    "hermes": "hermes-agent=Hermes agent",
    "pi": "pi-agent=Pi agent",
    "opencode": "opencode-agent=OpenCode agent",
    "dsh": "dsh-agent=DeepSeek agent",
}
SUPPORTED = {"dsh"}  # runtimes whose adapter serves the interaction protocol


def api_key():
    key = os.environ.get("OPENWEBUI_API_KEY")
    if not key and os.path.isfile(".env"):
        with open(".env") as f:
            for line in f:
                if line.startswith("OPENWEBUI_API_KEY="):
                    key = line.split("=", 1)[1].strip()
    if not key:
        sys.exit("OPENWEBUI_API_KEY is not set (environment or .env)")
    return key


def main():
    runtimes = [r.strip() for r in os.environ.get("AGENT_PIPE_RUNTIMES", "").split(",") if r.strip()]
    for r in runtimes:
        if r not in SUPPORTED:
            sys.exit(f"AGENT_PIPE_RUNTIMES: {r} has no interaction support yet (supported: {', '.join(sorted(SUPPORTED))})")
    ep = Endpoints()
    headers = {"Authorization": f"Bearer {api_key()}", "Content-Type": "application/json"}

    def call(method, path, body=None):
        data = json.dumps(body).encode() if body is not None else None
        try:
            with ep.open(method, f"{ep.webui}/api/v1/functions{path}", data=data, headers=headers) as res:
                raw = res.read()
        except urllib.error.HTTPError as ex:
            return ex.code, ex.read().decode("utf-8", "replace")
        # Unknown paths answer the SPA with 200; only JSON counts.
        try:
            return 200, json.loads(raw)
        except ValueError:
            sys.exit(f"{method} {path}: not a JSON answer; is {ep.webui} Open WebUI?")

    with open(SOURCE) as f:
        content = f.read()
    form = {"id": FUNCTION_ID, "name": "Personal agents (interactive)",
            "meta": {"description": "Agent chats with tool progress and permission prompts (docs/adr/0021)"},
            "content": content}
    status, current = call("GET", f"/id/{FUNCTION_ID}")
    if status == 200 and current:
        status, out = call("POST", f"/id/{FUNCTION_ID}/update", form)
    else:
        status, out = call("POST", "/create", form)
    if status != 200 or not out:
        sys.exit(f"saving the function failed: {status} {out}")
    if not out.get("is_active"):
        status, out = call("POST", f"/id/{FUNCTION_ID}/toggle")
        if status != 200 or not out.get("is_active"):
            sys.exit(f"activating the function failed: {status} {out}")
    valves = {"MODELS": ",".join(MODELS[r] for r in runtimes)}
    if os.environ.get("AGENT_PIPE_BROKER_URL"):
        valves["BROKER_URL"] = os.environ["AGENT_PIPE_BROKER_URL"]
    status, out = call("POST", f"/id/{FUNCTION_ID}/valves/update", valves)
    if status != 200:
        sys.exit(f"setting valves failed: {status} {out}")
    print(f"{FUNCTION_ID}: active, models: {valves['MODELS'] or '(none)'}")


if __name__ == "__main__":
    main()
