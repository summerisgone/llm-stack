#!/usr/bin/env python3
"""Generate a helm values overlay from .env (airgap-runtime secret data).

Pipes .env KVPs into helm/airgap-stack/runtime.secret.yaml as a
runtimeEnvironment block, so .env stays the source of truth for the workload
secret when running `make helm-up`. Any key in .env becomes a value; keys
already set via --set or a top-level values are overridden by the overlay.
"""

import os
import sys

ENV_FILE = os.environ.get("AIRGAP_ENV_FILE", ".env")
OUT = os.environ.get("AIRGAP_RUNTIME_VALUES", "helm/airgap-stack/runtime.secret.yaml")

lines = []
with open(ENV_FILE, "r", encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if not key:
            continue
        lines.append((key, value))

if not lines:
    sys.exit("no key/value pairs parsed from " + ENV_FILE)

buf = ["# Generated from %s by scripts/helm-env-values. Do not edit by hand." % ENV_FILE,
       "runtimeEnvironment:"]
for key, value in lines:
    buf.append("  %s: %s" % (key, value))

os.makedirs(os.path.dirname(OUT), exist_ok=True)
with open(OUT, "w") as f:
    f.write("\n".join(buf) + "\n")

print("wrote %d runtime keys -> %s" % (len(lines), OUT))