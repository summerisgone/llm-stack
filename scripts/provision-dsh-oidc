#!/usr/bin/env python3
"""Keycloak side of docs/adr/0020-dsh-runtime-and-per-user-web-ui.md: the
confidential client `dsh-web` used by the gateway's OIDC on the dsh host.
Idempotent; skipped when DSH_PUBLIC_ORIGIN is empty. The client secret is
DSH_OIDC_CLIENT_SECRET and the origin DSH_PUBLIC_ORIGIN, from the
environment or .env.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lib_keycloak_admin import KeycloakAdmin  # noqa: E402


def env_value(name, default=None):
    if os.environ.get(name):
        return os.environ[name]
    if os.path.isfile(".env"):
        with open(".env") as f:
            for line in f:
                if line.startswith(name + "="):
                    return line.rstrip("\n").split("=", 1)[1]
    return default


def main():
    origin = (env_value("DSH_PUBLIC_ORIGIN") or "").rstrip("/")
    if not origin:
        print("DSH_PUBLIC_ORIGIN not set; no dsh web UI, nothing to provision.")
        return
    secret = env_value("DSH_OIDC_CLIENT_SECRET")
    if not secret:
        sys.exit("DSH_OIDC_CLIENT_SECRET not set")

    client = {
        "clientId": "dsh-web",
        "name": "DeepSeek Harness web UI",
        "enabled": True,
        "protocol": "openid-connect",
        "publicClient": False,
        "secret": secret,
        "standardFlowEnabled": True,
        "directAccessGrantsEnabled": False,
        "redirectUris": [origin + "/oauth2/callback"],
        "webOrigins": [origin],
        "attributes": {"post.logout.redirect.uris": origin + "/*"},
        "defaultClientScopes": ["basic", "profile", "email", "roles"],
    }
    with KeycloakAdmin() as kc:
        found = kc.request("GET", "/clients?clientId=dsh-web")
        if found:
            kc.request("PUT", f"/clients/{found[0]['id']}", client)
        else:
            kc.request("POST", "/clients", client)
    print("dsh-web Keycloak OIDC client is ready.")


if __name__ == "__main__":
    main()
