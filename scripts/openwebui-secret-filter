#!/usr/bin/env python3
"""Install or update the global secret-redaction Filter
(config/openwebui/secret_filter.py, docs/adr/0024 decision 8) through Open
WebUI's admin API: create or update function `secret_filter`, activate it and
make it global so it runs for every model.

Needs OPENWEBUI_API_KEY (an admin's key) from the environment or .env, and
STACK_BASE_URL like the smoke tests (scripts/lib_endpoints.py). Run from the
repository root: `make openwebui-secret-filter`.
"""
import json
import os
import sys
import urllib.error

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from lib_endpoints import Endpoints  # noqa: E402

FUNCTION_ID = "secret_filter"
SOURCE = "config/openwebui/secret_filter.py"


def api_key():
    key = os.environ.get("OPENWEBUI_API_KEY")
    if not key and os.path.isfile(".env"):
        with open(".env") as f:
            for line in f:
                if line.startswith("OPENWEBUI_API_KEY="):
                    key = line.split("=", 1)[1].strip()
    if not key:
        sys.exit("OPENWEBUI_API_KEY is not set (environment or .env)")
    return key


def main():
    ep = Endpoints()
    headers = {"Authorization": f"Bearer {api_key()}", "Content-Type": "application/json"}

    def call(method, path, body=None):
        data = json.dumps(body).encode() if body is not None else None
        try:
            with ep.open(method, f"{ep.webui}/api/v1/functions{path}", data=data, headers=headers) as res:
                raw = res.read()
        except urllib.error.HTTPError as ex:
            return ex.code, ex.read().decode("utf-8", "replace")
        try:
            return 200, json.loads(raw)
        except ValueError:
            sys.exit(f"{method} {path}: not a JSON answer; is {ep.webui} Open WebUI?")

    with open(SOURCE) as f:
        content = f.read()
    form = {"id": FUNCTION_ID, "name": "Secret redaction",
            "meta": {"description": "Masks credentials in messages and stored chats (docs/adr/0024)"},
            "content": content}
    status, current = call("GET", f"/id/{FUNCTION_ID}")
    if status == 200 and current:
        status, out = call("POST", f"/id/{FUNCTION_ID}/update", form)
    else:
        status, out = call("POST", "/create", form)
    if status != 200 or not out:
        sys.exit(f"saving the function failed: {status} {out}")
    if not out.get("is_active"):
        status, out = call("POST", f"/id/{FUNCTION_ID}/toggle")
        if status != 200 or not out.get("is_active"):
            sys.exit(f"activating the function failed: {status} {out}")
    if not out.get("is_global"):
        status, out = call("POST", f"/id/{FUNCTION_ID}/toggle/global")
        if status != 200 or not out.get("is_global"):
            sys.exit(f"making the function global failed: {status} {out}")
    print(f"{FUNCTION_ID}: active, global")


if __name__ == "__main__":
    main()
