#!/usr/bin/env python3
"""Render the remote kustomize profile into the wrapper chart templates.

Replaces the hand-written kustomize apply that `nvfp4-up` performed with a
Helm-owned render: `helm upgrade` then diffs and applies the whole stack and
tracks removal of deleted objects. GPU inference objects that the user keeps
out of Helm (the vLLM Deployment/Service, the `nvidia` RuntimeClass, and the
model PV/PVC) are filtered here so they stay outside the release and stay
managed by hand / by scripts.

Routing is owned by the chart templates, never by the kustomize overlay. This
script used to drop routing objects from the render silently, which let a
second, drifting copy of a Gateway or an AIGatewayRoute live in the overlay
and be applied by a stray `kubectl apply -k` while the chart applied the real
one. It now fails instead: if a routing object appears in the overlay render,
delete it there or move it into helm/airgap-stack/templates.
"""

import os
import shutil
import subprocess

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TOP_KUSTOMIZE = os.environ.get("HELM_RENDER_TOP_KUSTOMIZE", "k8s")          # realm CM
OVERLAY_KUSTOMIZE = os.environ.get(
    "HELM_RENDER_OVERLAY_KUSTOMIZE", "k8s/overlays/remote-wsl-vllm-nvfp4")
OUT = os.environ.get("HELM_RENDER_OUT",
                     "helm/airgap-stack/templates/resources.yaml")
MANIFEST = os.environ.get("HELM_RENDER_MANIFEST",
                          "helm/airgap-stack/manifest.yaml")

# (kind, name) pairs left out of the Helm release. Kept in the repo for
# manual/scripted GPU management.
GPU_KEEP_OUT = {
    ("Deployment", "vllm-qwen38-nvfp4"),
    ("Service", "vllm-qwen38-nvfp4"),
    ("RuntimeClass", "nvidia"),
    ("PersistentVolume", "vllm-qwen38-nvfp4-model"),
    ("PersistentVolumeClaim", "vllm-qwen38-nvfp4-model"),
    # docs/adr/0013-embeddings-api-bge-m3.md: same reasoning as the vLLM model
    # PV/PVC above, in both accelerator modes.
    ("PersistentVolume", "embeddings-bge-m3-model"),
    ("PersistentVolumeClaim", "embeddings-bge-m3-model"),
}

# Network/routing objects are owned by chart templates (values-driven host,
# ports, path routing). Finding one in the overlay render means there are two
# definitions of the same object, so it is an error, not something to filter.
# GatewayClass is deliberately absent: it is cluster-scoped, carries no
# site-specific values, and stays in k8s/base.
ROUTING_KINDS = {
    "Gateway",
    "EnvoyProxy",
    "HTTPRoute",
    "AIGatewayRoute",
    "Backend",
    "AIServiceBackend",
    "SecurityPolicy",
    "BackendTrafficPolicy",
}


def kustomize(path):
    return subprocess.run(["kubectl", "kustomize", path],
                          check=True, capture_output=True, text=True,
                          cwd=ROOT).stdout


def split_docs(text):
    """Yield each YAML document (buffer, first non-comment line, kind, name)."""
    docs = text.split("\n---\n")
    for doc in docs:
        doc = doc.strip("\n")
        if not doc.strip():
            continue
        first = ""
        kind = ""
        name = ""
        for line in doc.splitlines():
            if first == "" and line.strip() and not line.strip().startswith("#"):
                first = line.strip()
            if kind == "" and line.strip().startswith("kind:"):
                kind = line.split(":", 1)[1].strip()
            if name == "" and line.strip().startswith("name:"):
                name = line.split(":", 1)[1].strip()
        yield doc, first, kind, name


def main():
    overlay = kustomize(os.path.join(ROOT, OVERLAY_KUSTOMIZE))
    top = kustomize(os.path.join(ROOT, TOP_KUSTOMIZE))

    # The top-level kustomization contributes the keycloak-realm ConfigMap
    # (configMapGenerator) which the overlay render does not include.
    realm_cm = ""
    for doc, first, kind, name in split_docs(top):
        if kind == "ConfigMap" and name == "keycloak-realm":
            realm_cm = doc
            break
    if not realm_cm:
        raise SystemExit("keycloak-realm ConfigMap not found in top-level render")

    docs = []
    stray_routing = []
    for doc, first, kind, name in split_docs(overlay):
        if (kind, name) in GPU_KEEP_OUT:
            continue
        if kind in ROUTING_KINDS:
            stray_routing.append(f"{kind}/{name}")
            continue
        if kind == "Namespace":
            # Helm manages the namespace lifecycle itself via --namespace
            # + --create-namespace; never template the namespace object.
            continue
        docs.append(doc.strip())

    if stray_routing:
        raise SystemExit(
            "routing objects found in %s: %s\n"
            "Routing is owned by helm/airgap-stack/templates. Delete these "
            "from the overlay, or move them into the chart -- do not let a "
            "second copy drift." % (OVERLAY_KUSTOMIZE, ", ".join(sorted(stray_routing)))
        )

    header = (
        "# Generated by scripts/helm-render. Do not edit by hand.\n"
        f"# Source: kubectl kustomize {OVERLAY_KUSTOMIZE} "
        "(GPU inference objects and Namespace excluded).\n"
    )
    body = "\n---\n" + "\n---\n".join(docs) + "\n"
    body = body.replace("---\n---", "---\n")  # drop empty separators
    if realm_cm:
        body = body + "\n---\n" + realm_cm.strip() + "\n"

    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w") as f:
        f.write(header + body)

    # Manifest of what the templates render to, for a stable git diff.
    docs_meta = []
    for doc, first, kind, name in split_docs(body):
        docs_meta.append(f"{kind}\t{name}\t{first}")
    os.makedirs(os.path.dirname(MANIFEST), exist_ok=True)
    with open(MANIFEST, "w") as f:
        f.write("# Generated by scripts/helm-render. Do not edit by hand.\n")
        f.write("kind\tname\tkindline\n")
        f.write("\n".join(docs_meta) + "\n")

    print(f"rendered {len(docs_meta)} objects -> {OUT}")
    print(f"manifest -> {MANIFEST}")


if __name__ == "__main__":
    main()